# Postgres configuration (MLflow backend store)
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_DATABASE=mlflow
MLFLOW_DB_PORT=5432

# MLflow configuration
MLFLOW_PORT=5000
MLFLOW_BUCKET_NAME=mlflow

# MinIO root credentials (MinIO server)
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_pwd
MINIO_ADDRESS=:9000
MINIO_STORAGE_USE_HTTPS=False
MINIO_CONSOLE_ADDRESS=:9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Client access keys (used by MLflow/minio client)
# For local single-node, make these equal to the MinIO root creds
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_ACCESS_KEY=minio_pwd

# Postgres configuration (Prefect backend)
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=prefect
PREFECT_DB_DATABASE=prefect
PREFECT_DB_PORT=5433

# Evidently
EVIDENTLY_BUCKET_NAME=evidently